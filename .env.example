# PDFPulse Environment Configuration Example
# Copy this file to .env or export these variables in your environment

# Server Port (default: 8080)
PORT=8080

# Maximum Multipart Upload Size (default: 50MB)
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB

# Optional AI API Key for Gemini (If not provided, built-in offline NLP engine is used)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional Tesseract OCR path override if not installed in default system paths
# TESSERACT_PATH=/opt/homebrew/bin/tesseract
